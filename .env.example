# Notion integration secret. Get it from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Full path to your Obsidian vault on disk, e.g. /Users/pranamya/Documents/MyVault
OBSIDIAN_VAULT_PATH=/Users/yourname/path/to/vault

# Which page trees to sync (root page ID + matching vault folder, one per
# pair) now live in sync-pairs.json — copy sync-pairs.example.json to
# sync-pairs.json and fill it in.
